<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseAppHost>true</UseAppHost>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>8.0.31</RuntimeFrameworkVersion>
    <RollForward>LatestPatch</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>WebViewCheck.Program</StartupObject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Compile Include="Program.cs" />
    <Compile Include="VisibleCheck.cs" />
    <Compile Include="../NativeProcesses.cs" Link="NativeProcesses.cs" />
    <Compile Include="../TerminalSecurity.cs" Link="TerminalSecurity.cs" />
    <Compile Include="../LaunchValidation.cs" Link="LaunchValidation.cs" />
    <Compile Include="../TerminalProfiles.cs" Link="TerminalProfiles.cs" />
    <Compile Include="../TerminalServer.cs" Link="TerminalServer.cs" />
    <Compile Include="../TerminalWorker.cs" Link="TerminalWorker.cs" />
    <Compile Include="../DesktopHost.cs" Link="DesktopHost.cs" />
    <Compile Include="../LaunchDialog.cs" Link="LaunchDialog.cs" />
    <EmbeddedResource Include="../bundle-manifest.json" LogicalName="AgentFoundry.bundle.json" />
  </ItemGroup>
</Project>
